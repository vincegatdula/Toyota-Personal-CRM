# ---------------------------------------------------------------------------
# Supabase (Project Settings -> API)
# ---------------------------------------------------------------------------
# Public URL of your Supabase project, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key. Safe to expose to the browser; RLS protects your data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only (never expose to the browser, never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Service role key. ONLY used by server-side scripts (seed / admin tasks).
# Leave blank in the deployed frontend unless you explicitly need it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Canonical site URL used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# IANA timezone used for reporting period boundaries.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Manila

# Supabase Storage (avatars)
# Create a private bucket named `profile-avatars` in Supabase Dashboard.
# Profile avatar paths are stored in `profiles.avatar_url`; server code signs URLs.
